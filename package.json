{
  "name": "nisum-commerce-mfe-platform",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Production-oriented React micro frontend platform built for the Nisum MFE final project.",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k -n api,products,cart,orders,gateway -c blue,magenta,green,yellow,cyan \"npm run dev --workspace=@nisum/api\" \"npm run dev --workspace=@nisum/products-mfe\" \"npm run dev --workspace=@nisum/cart-mfe\" \"npm run dev --workspace=@nisum/orders-mfe\" \"npm run dev --workspace=@nisum/gateway\"",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@module-federation/vite": "^1.2.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.0.5",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "http-server": "^14.1.1",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.6",
    "supertest": "^7.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.5.1",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.1.5"
  }
}
